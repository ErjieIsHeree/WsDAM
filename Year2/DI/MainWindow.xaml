<Window x:Class="PruebaExamen00.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:PruebaExamen00"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        Title="LinkiaGram by Metalex84" Height="600" Width="300"
        ResizeMode="NoResize"
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.15*"/>
            <RowDefinition Height="0.85*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Grid.Row="0" x:Name="HELP">
            <StackPanel Orientation="Horizontal">
                <Label HorizontalAlignment="Center" Foreground="Black" VerticalAlignment="Center" Padding="10" FontSize="22" FontWeight="Bold">
                    LinkiaGram
                </Label>
                <Label HorizontalAlignment="Center" VerticalAlignment="Center" Margin="50,0,0,0">DarkMode</Label>
                <ToggleButton x:Name="ToggleMode" Cursor="Hand" Checked="ToggleMode_Checked" Unchecked="ToggleMode_Unchecked" />
            </StackPanel>
            <UniformGrid Grid.Row="1" Columns="4">
                <Button Style="{StaticResource MaterialDesignFlatButton}" Margin="10" Background="White" Foreground="Black">
                    <materialDesign:PackIcon Kind="Home"/>
                </Button>
                <Button Style="{StaticResource MaterialDesignFlatButton}" Margin="10" Background="White" Foreground="Black">
                    <materialDesign:PackIcon Kind="Search"/>
                </Button>
                <Button Style="{StaticResource MaterialDesignFlatButton}" Margin="10" Background="White" Foreground="Black">
                    <materialDesign:PackIcon Kind="Explore"/>
                </Button>
                <Button Style="{StaticResource MaterialDesignFlatButton}" Margin="10" Cursor="Hand" Background="White" Foreground="Black">
                    <materialDesign:PackIcon Kind="Menu"/>
                </Button>
            </UniformGrid>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Background="White">
            <StackPanel>

                <Border Margin="10" Padding="10" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Foreground="Black" Text="Erjie Xia" Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                        <Image Source="Erjie.jpg" Height="200" Stretch="UniformToFill"/>
                        <TextBlock Foreground="Black" Text="El gran filántropo playboy caballo ganador de las IAs" Style="{StaticResource MaterialDesignTextBlock}"/>
                    </StackPanel>
                </Border>
                <Border Margin="10" Padding="10" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Foreground="Black" Text="Cateto21" Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                        <Image Source="work.png" Height="200" Stretch="UniformToFill"/>
                        <TextBlock Foreground="Black" Text="Primer día de prácticas. Esto se me está haciendo eterno..." Style="{StaticResource MaterialDesignTextBlock}"/>
                    </StackPanel>
                </Border>

                <Border Margin="10" Padding="10" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Foreground="Black" Text="Hormonauta23" Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                        <Image Source="gym.png" Height="200" Stretch="UniformToFill"/>
                        <TextBlock Foreground="Black" Text="No pain, no gain." Style="{StaticResource MaterialDesignTextBlock}"/>
                    </StackPanel>
                </Border>

                <Border Margin="10" Padding="10" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Foreground="Black" Text="Sara_ndonga" Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                        <Image Source="exams.png" Height="200" Stretch="UniformToFill"/>
                        <TextBlock Foreground="Black" Text="Último examen del curso. ¿Aprobaré?" Style="{StaticResource MaterialDesignTextBlock}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>